# Place these values in the repository-root .env, which is excluded from Git.
GEMINI_API_KEY=replace_with_your_private_key
AI_PROVIDER=google
AI_MODEL=gemini-4-argon
AI_ENABLED=true
AI_THINKING_LEVEL=medium
# Optional controls (defaults shown). Attempts include retries; no model fallback.
AI_MAX_CALLS=5
AI_MAX_PUBLICATIONS=4
AI_MAX_TRIALS=6
AI_EXCERPT_CHARS=2400
AI_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_SECONDS=120
AI_RETRIES=1
