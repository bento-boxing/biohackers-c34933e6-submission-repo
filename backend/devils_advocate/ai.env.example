# Place these values in the repository-root .env, which is excluded from Git.
ANTHROPIC_API_KEY=replace_with_your_private_key
AI_MODEL=claude-opus-5-5
AI_ENABLED=true
# Sent as output_config.effort (low | medium | high); thinking itself is adaptive.
AI_THINKING_LEVEL=medium
# Optional controls (defaults shown). Attempts include retries.
AI_MAX_CALLS=7
AI_MAX_PUBLICATIONS=4
AI_MAX_TRIALS=6
AI_EXCERPT_CHARS=2400
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_SECONDS=120
AI_RETRIES=1
