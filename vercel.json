{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "git": {
    "deploymentEnabled": {
      "prod": true,
      "**": false
    }
  }
} 
